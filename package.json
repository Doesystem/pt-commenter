{
    "name": "pt-commenter",
    "version": "0.0.5",
    "type": "module",
    "description": "A PT commenter agent built with @lifetimesoft/agent-sdk",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "start": "node dist/index.js",
        "clean": "rm -rf dist data",
        "clean:data": "rm -rf data",
        "lint": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Doesystem/pt-commenter.git"
    },
    "keywords": [
        "pt",
        "commenter",
        "agent"
    ],
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Doesystem/pt-commenter/issues"
    },
    "homepage": "https://github.com/Doesystem/pt-commenter#readme",
    "dependencies": {
        "@lifetimesoft/agent-sdk": "0.0.13",
        "playwright": "^1.58.2",
        "rss-parser": "^3.13.0"
    },
    "devDependencies": {
        "typescript": "5.9.3",
        "vitest": "3.2.4",
        "@types/node": "^22.0.0"
    }
}